---
interface Link { href: string; rotulo: string; opcional?: boolean; lang?: string; classe?: string; atual?: boolean }

interface Props {
  links: Link[];
  cta: { href: string; rotulo: string; externo?: boolean };
  escuro?: boolean;
  homeHref?: string;
  rotuloMenu?: string;
  rotuloHome?: string;
}

const {
  links, cta, escuro = false, homeHref = '/',
  rotuloMenu = 'Menu principal', rotuloHome = 'Isadora Massarioli, página inicial',
} = Astro.props;
const logo = escuro ? '/images/logo-escuro.png' : '/images/logo1.png';
---
<header class="site-nav">
  <a class="nav-home" href={homeHref} aria-label={rotuloHome}>
    <img class="nav-logo" src={logo} alt="Logo de Isadora Massarioli: estrela de quatro pontas sobre formas em rosa e roxo, ao lado do nome em letra serifada itálica" width="98" height="30">
  </a>
  <div class="nav-right">
    <nav aria-label={rotuloMenu}>
      <ul class="nav-links">
        {links.map((l) => (
          <li class={l.opcional ? 'nav-opt' : undefined}>
            <a href={l.href} lang={l.lang} class={l.classe} aria-current={l.atual ? 'page' : undefined}>{l.rotulo}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href={cta.href} class="btn btn-primary" {...(cta.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{cta.rotulo}</a>
  </div>
</header>

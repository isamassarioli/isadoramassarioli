---
import CasePage from '../../components/CasePage.astro';
import { casesPublicados, type Case } from '../../data/cases';

// Gera uma página para cada case publicado. Rascunhos (publicado: false) não viram página.
export function getStaticPaths() {
  return casesPublicados.map((caso) => ({ params: { slug: caso.slug }, props: { caso } }));
}

const { caso } = Astro.props as { caso: Case };
---
<CasePage caso={caso} lang="pt" />

---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Faixa from '../components/Faixa.astro';
import Estrela from '../components/Estrela.astro';
import '../styles/lp.css';
import { contato } from '../data/site';
import { lp } from '../data/lp';
import { projetos, rotuloCategoria, slugProjeto } from '../data/projetos';

const destaques = lp.cases.destaques
  .map((d) => projetos.find((p) => p.nome === d.nome && p.cats[0] === d.cat))
  .filter((p): p is NonNullable<typeof p> => Boolean(p?.caso));
const temDepoimentos = lp.depoimentos.itens.length > 0;
---
<Base title={lp.meta.titulo} description={lp.meta.descricao} bodyClass="tema-marca">
<Nav
  marca
  links={[
    { href: '#cases', rotulo: 'Cases' },
    { href: '#estrategia', rotulo: 'Estratégia', opcional: true },
    { href: '#servicos', rotulo: 'Serviços', opcional: true },
    { href: '/productdesign', rotulo: 'Product design', opcional: true },
  ]}
  cta={{ href: '#briefing', rotulo: 'Pedir orçamento', externo: false }}
/>

<main id="conteudo" tabindex="-1">

  <!-- 1. ABERTURA -->
  <section class="lp-hero" aria-labelledby="hero-titulo">
    <div class="lp-hero-moldura">
      <img class="lp-hero-img" src="/images/fotos/ensaio-1.webp" alt={lp.hero.fotoAlt} width="1333" height="2000" fetchpriority="high">
      <div class="lp-hero-veu" aria-hidden="true"></div>
    </div>
    <div class="lp-hero-texto">
      <div>
        <span class="lp-eyebrow">{lp.hero.eyebrow}</span>
        <h1 class="lp-h1" id="hero-titulo">
          {lp.hero.tituloAntes}<em class="sublinhado">{lp.hero.tituloDestaque}<svg class="sublinhado-traco" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M3 14 C 60 4, 120 4, 170 10 S 260 16, 297 6" pathLength="1" /></svg></em>{lp.hero.tituloDepois}
        </h1>
        <p class="lp-lead">{lp.hero.apoio}</p>
        <p class="lp-obj">{lp.hero.objecao}</p>
        <div class="lp-cta-row">
          <a class="btn btn-primary btn-lg" href="#briefing">{lp.hero.cta}</a>
          <a class="btn btn-ghost btn-lg" href="#cases">{lp.hero.cta2}</a>
        </div>
      </div>
    </div>
    <div class="lp-selo"><strong>{lp.hero.selo.numero}</strong><span>{lp.hero.selo.rotulo}</span></div>
  </section>

  <Faixa />

  <!-- 2. DOR: perguntas em letreiro contínuo -->
  <section class="lp-sec lp-dor" aria-labelledby="dor-titulo" data-reveal>
    <div class="lp-wrap">
      <h2 class="lp-h2" id="dor-titulo">{lp.dor.titulo}</h2>
    </div>
    <div class="letreiro" id="letreiro">
      <button type="button" class="letreiro-pausa" aria-pressed="false" data-rotulo-pausar="Pausar o letreiro" data-rotulo-tocar="Retomar o letreiro">Pausar o letreiro</button>
      {[0, 1].map((linha) => {
        const qs = lp.dor.perguntas.filter((_, i) => i % 2 === linha);
        return (
          <div class:list={['letreiro-linha', { reverso: linha === 1 }]}>
            <ul class="letreiro-trilho" aria-label={linha === 0 ? 'Perguntas que donos de negócio costumam se fazer' : 'Mais perguntas'}>
              {qs.map((q) => <li class="lp-q"><Estrela />{q}</li>)}
            </ul>
            <ul class="letreiro-trilho" aria-hidden="true">
              {qs.map((q) => <li class="lp-q"><Estrela />{q}</li>)}
            </ul>
          </div>
        );
      })}
    </div>
    <div class="lp-wrap"><p class="lp-fecho">{lp.dor.fecho}</p></div>
  </section>

  <!-- 3. ANTES DO VISUAL, A ESTRATÉGIA -->
  <section class="lp-sec lp-dark" id="estrategia" aria-labelledby="estrategia-titulo" data-reveal>
    <div class="lp-wrap lp-estrategia-grid">
      <div>
        <span class="lp-eyebrow">{lp.estrategia.eyebrow}</span>
        <h2 class="lp-h2" id="estrategia-titulo">{lp.estrategia.titulo}</h2>
        <div class="lp-estrategia-texto">
          {lp.estrategia.texto.map((t, i) => <p class:list={{ 'lp-frase': i === lp.estrategia.texto.length - 1 }}>{t}</p>)}
        </div>
      </div>
      <figure class="laudo">
        <div class="laudo-papel">
          <span class="laudo-fita" aria-hidden="true"></span>
          <header class="laudo-topo">
            <img src="/images/marca/simbolo.svg" alt="" width="22" height="39" aria-hidden="true">
            <div>
              <strong>Diagnóstico de marca</strong>
              <span>Cliente: <span class="laudo-tarja" role="img" aria-label="nome do cliente oculto"></span></span>
            </div>
          </header>
          <ol class="laudo-blocos">
            {lp.estrategia.blocos.map((b) => (
              <li>
                <h3>{b.titulo}</h3>
                <p>{b.texto}</p>
                <span class="laudo-linhas" aria-hidden="true"><i></i><i></i><i></i></span>
              </li>
            ))}
          </ol>
        </div>
        <figcaption>{lp.estrategia.nota}</figcaption>
      </figure>
    </div>
  </section>

  <!-- 4. PROVA -->
  <section class="lp-sec" id="resultados" aria-labelledby="prova-titulo" data-reveal>
    <div class="lp-wrap">
      <h2 class="lp-h2 lp-head" id="prova-titulo">{lp.prova.titulo}</h2>
      <ul class="lp-resultados">
        {lp.prova.resultados.map((r) => (
          <li class="lp-resultado"><strong><mark>{r.numero}</mark></strong><span>{r.rotulo}</span><em>{r.cliente}</em></li>
        ))}
      </ul>
      <ul class="lp-numeros">
        {lp.prova.numeros.map((n) => <li class="lp-numero"><strong>{n.numero}</strong><span>{n.rotulo}</span></li>)}
      </ul>
      <div class="lp-carrossel">
        <div class="lp-marcas-janela">
          <div class="lp-marcas-trilho">
            {[false, true].map(copia => (
              <ul class="lp-marcas" aria-label={copia ? undefined : 'Marcas atendidas'} aria-hidden={copia ? 'true' : undefined}>
                {lp.prova.marcas.map(m => <li class="lp-marca">{m}</li>)}
              </ul>
            ))}
          </div>
        </div>
        <label class="lp-marcas-pausa"><input type="checkbox" /> Pausar movimento</label>
      </div>
    </div>
  </section>

  <Faixa fina />

  <!-- 5. CASES EM 3 ATOS -->
  <section class="lp-sec lp-mist" id="cases" aria-labelledby="cases-titulo" data-reveal>
    <div class="lp-wrap">
      <div class="lp-head">
        <span class="lp-eyebrow">{lp.cases.eyebrow}</span>
        <h2 class="lp-h2 lp-wide" id="cases-titulo">{lp.cases.titulo}</h2>
      </div>
      <ol class="lp-cases">
        {destaques.map((p) => {
          const capa = p.capa ?? p.imagens![0];
          const c = p.caso!;
          return (
            <li class="lp-case">
              <a class="lp-case-img" href={`/portfolio#${slugProjeto(p)}`} tabindex="-1" aria-hidden="true">
                <img src={capa.src} alt={capa.alt} loading="lazy">
              </a>
              <div class="lp-case-body">
                <span class="lp-case-cat">{rotuloCategoria[p.cats[0]]}</span>
                <h3 class="lp-case-title">{p.nome}</h3>
                <dl class="lp-atos">
                  <div><dt>{lp.cases.atos.pediu}</dt><dd>{c.curto.pediu}</dd></div>
                  <div><dt>{lp.cases.atos.fiz}</dt><dd>{c.curto.fiz}</dd></div>
                  <div class="ato-resultado"><dt>{lp.cases.atos.resultado}</dt><dd>{c.curto.resultado}</dd></div>
                </dl>
                <a class="lp-case-go" href={`/portfolio#${slugProjeto(p)}`}>{lp.cases.ver}<span class="sr-only">: {p.nome}</span> →</a>
              </div>
            </li>
          );
        })}
      </ol>
      <div class="lp-more"><a class="btn btn-ghost btn-lg" href="/portfolio">{lp.cases.todos}</a></div>
    </div>
  </section>

  <!-- 6. MÉTODO: linha do tempo que avança com o scroll -->
  <section class="lp-sec lp-dark lp-metodo" id="metodo" aria-labelledby="metodo-titulo">
    <div class="metodo-palco">
      <div class="lp-wrap metodo-cabeca">
        <span class="lp-eyebrow">{lp.metodo.eyebrow}</span>
        <h2 class="lp-h2" id="metodo-titulo">{lp.metodo.titulo}</h2>
        <p class="lp-lead">{lp.metodo.texto}</p>
      </div>
      <div class="metodo-trilho-wrap">
        <div class="metodo-linha" aria-hidden="true"><span class="metodo-progresso"></span></div>
        <ol class="lp-etapas">
          {lp.metodo.etapas.map((e, i) => (
            <li class:list={['lp-etapa', { atual: i === 0 }]}>
              <span class="etapa-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{e.titulo}</h3>
              <p>{e.texto}</p>
              <p class="etapa-entrega"><span>{lp.metodo.rotuloEntrega}</span>{e.entrega}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="lp-wrap metodo-cta">
        <a class="btn btn-primary btn-lg" href="#briefing">{lp.metodo.cta}</a>
      </div>
    </div>
  </section>

  <!-- 7. SERVIÇOS -->
  <section class="lp-sec" id="servicos" aria-labelledby="servicos-titulo" data-reveal>
    <div class="lp-wrap">
      <div class="lp-head">
        <span class="lp-eyebrow">{lp.servicos.eyebrow}</span>
        <h2 class="lp-h2" id="servicos-titulo">{lp.servicos.titulo}</h2>
      </div>
      <ul class="lp-servicos">
        {lp.servicos.itens.map((s) => (
          <li class:list={{ 'svc-destaque': s.destaque }}>
            <a class="lp-svc" href={s.href}>
              {s.destaque && <Estrela class="svc-estrela" />}
              <h3>{s.titulo}</h3>
              <p class="ganho">{s.ganho}</p>
              <p class="desc">{s.texto}</p>
              <span class="go" aria-hidden="true">{s.href.startsWith('#') ? 'Ver como funciona →' : 'Ver exemplos →'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. DEPOIMENTOS (só aparece com depoimentos preenchidos em src/data/lp.ts) -->
  {temDepoimentos && (
    <section class="lp-sec lp-mist" aria-labelledby="depo-titulo" data-reveal>
      <div class="lp-wrap">
        <h2 class="lp-h2 lp-head" id="depo-titulo">{lp.depoimentos.titulo}</h2>
        <ul class="lp-depo">
          {lp.depoimentos.itens.map((d) => (
            <li>
              <figure>
                <blockquote>“{d.texto}”</blockquote>
                <figcaption><strong>{d.nome}</strong>{d.negocio}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 9. SOBRE -->
  <section class="lp-sec lp-dark" id="sobre" aria-labelledby="sobre-titulo" data-reveal>
    <div class="lp-wrap lp-sobre-grid">
      <div class="lp-sobre-foto">
        <img src="/images/fotos/ensaio-2-sobre.webp" alt={lp.sobre.fotoAlt} width="720" height="900" loading="lazy">
        <Estrela class="lp-brilho b3" />
      </div>
      <div>
        <span class="lp-eyebrow">{lp.sobre.eyebrow}</span>
        <h2 class="lp-h2" id="sobre-titulo">{lp.sobre.titulo}</h2>
        {lp.sobre.textos.map((t, i) => <p class:list={{ 'lp-frase': i === lp.sobre.textos.length - 1 }}>{t}</p>)}
        <div class="lp-cta-row">
          <a class="btn btn-primary btn-lg" href="#briefing">{lp.sobre.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. DÚVIDAS -->
  <section class="lp-sec lp-mist" id="duvidas" aria-labelledby="faq-titulo" data-reveal>
    <div class="lp-wrap">
      <div class="lp-head lp-center">
        <span class="lp-eyebrow">{lp.faq.eyebrow}</span>
        <h2 class="lp-h2" id="faq-titulo">{lp.faq.titulo}</h2>
      </div>
      <div class="lp-faq">
        {lp.faq.itens.map((f) => (
          <details>
            <summary>{f.p}</summary>
            <div class="resp">
              <p style="margin:0">{f.r}</p>
              {f.link && <p style="margin:12px 0 0"><a href={f.link.href}>{f.link.rotulo} →</a></p>}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. FECHAMENTO -->
  <section class="lp-sec lp-final" id="contato" aria-labelledby="contato-titulo" data-reveal>
    <div class="lp-blob lp-blob-rosa" aria-hidden="true"></div>
    <div class="lp-blob lp-blob-ameixa" aria-hidden="true"></div>
    <span class="lp-eyebrow">{lp.final.eyebrow}</span>
    <h2 class="lp-h2" id="contato-titulo">{lp.final.titulo}</h2>
    <p>{lp.final.texto}</p>
    <a class="btn btn-primary btn-lg" href="#briefing">{lp.final.cta}</a>
    <p class="lp-email">Ou escreva para <a href={contato.emailHref}>{contato.email}</a></p>
  </section>
  <section id="briefing" aria-label="Briefing inicial" style="scroll-margin-top:5rem;background:#fffefa">
    <iframe id="brief-frame" title="Briefing inicial da agência" src="https://massarioli-agencia.vercel.app/briefing" loading="lazy" style="width:100%;height:1250px;border:0;display:block"></iframe>
    <p style="text-align:center;padding:1rem"><a href="https://massarioli-agencia.vercel.app/briefing">Abrir formulário em página inteira</a></p>
  </section>
</main>

<Faixa fina />
<Footer marca links={[{ href: '/portfolio', rotulo: 'Portfólio' }, { href: '/bio', rotulo: 'Links' }, { href: '/productdesign', rotulo: 'Vagas e trabalho em produto' }]} />

<script>
  import { iniciarMovimento } from '../scripts/movimento';
  iniciarMovimento();
  const frame=document.querySelector<HTMLIFrameElement>('#brief-frame');
  window.addEventListener('message',event=>{
    if(frame && event.origin==='https://massarioli-agencia.vercel.app' && event.source===frame.contentWindow && event.data?.type==='brief-height' && Number.isFinite(event.data.height)){
      frame.style.height=Math.min(9000,Math.max(280,event.data.height))+'px';
    }
  });
</script>
</Base>

---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/lp.css';
import { contato } from '../data/site';
import { lp } from '../data/lp';
import { projetos, rotuloCategoria, slugProjeto } from '../data/projetos';

const destaques = lp.cases.destaques
  .map((d) => projetos.find((p) => p.nome === d.nome && p.cats[0] === d.cat))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const temResultados = lp.prova.resultados.length > 0;
const temDepoimentos = lp.depoimentos.itens.length > 0;
---
<Base title={lp.meta.titulo} description={lp.meta.descricao}>
<Nav
  links={[
    { href: '#cases', rotulo: 'Cases' },
    { href: '#servicos', rotulo: 'Serviços', opcional: true },
    { href: '#sobre', rotulo: 'Sobre', opcional: true },
    { href: '/productdesign', rotulo: 'Product design', opcional: true },
  ]}
  cta={{ href: contato.whatsappOrcamento, rotulo: 'Pedir orçamento', externo: true }}
/>

<main id="conteudo" tabindex="-1">

  <!-- 1. ABERTURA -->
  <section class="lp-sec lp-dark lp-hero" aria-labelledby="hero-titulo">
    <div class="lp-wrap lp-hero-grid">
      <div>
        <span class="lp-eyebrow">{lp.hero.eyebrow}</span>
        <h1 class="lp-h1" id="hero-titulo">{lp.hero.tituloAntes}<em>{lp.hero.tituloDestaque}</em>{lp.hero.tituloDepois}</h1>
        <p class="lp-lead">{lp.hero.apoio}</p>
        <p class="lp-obj">{lp.hero.objecao}</p>
        <div class="lp-cta-row">
          <a class="btn btn-primary btn-lg" href={contato.whatsappOrcamento} target="_blank" rel="noopener noreferrer">{lp.hero.cta}</a>
          <a class="btn btn-ghost btn-lg" href="#cases">{lp.hero.cta2}</a>
        </div>
      </div>
      <div class="lp-photo">
        <div class="lp-photo-frame">
          <img src="/images/foto-isadora.jpg" alt={lp.hero.fotoAlt} width="640" height="640" fetchpriority="high">
        </div>
        <div class="lp-selo"><strong>{lp.hero.selo.numero}</strong><span>{lp.hero.selo.rotulo}</span></div>
      </div>
    </div>
  </section>

  <!-- 2. DOR -->
  <section class="lp-sec lp-tex lp-dor" aria-labelledby="dor-titulo" data-reveal>
    <div class="lp-wrap">
      <h2 class="lp-h2" id="dor-titulo">{lp.dor.titulo}</h2>
      <span class="lp-hint" aria-hidden="true">{lp.dor.dica} →</span>
    </div>
    <ul class="lp-qs" tabindex="0" aria-label="Perguntas que donos de negócio costumam se fazer">
      {lp.dor.perguntas.map((q) => <li class="lp-q">{q}</li>)}
    </ul>
    <div class="lp-wrap"><p class="lp-fecho">{lp.dor.fecho}</p></div>
  </section>

  <!-- 3. VIRADA -->
  <section class="lp-sec lp-light" aria-labelledby="virada-titulo" data-reveal>
    <div class="lp-wrap lp-virada-grid">
      <div>
        <span class="lp-eyebrow">{lp.virada.eyebrow}</span>
        <h2 class="lp-h2 lp-wide" id="virada-titulo">{lp.virada.titulo}</h2>
        <div class="lp-virada-texto" style="margin-top:22px">
          {lp.virada.textos.map((t) => <p>{t}</p>)}
        </div>
      </div>
      <ul class="lp-pilares">
        {lp.virada.pilares.map((p) => (
          <li class="lp-pilar"><h3>{p.titulo}</h3><p>{p.texto}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. PROVA -->
  <section class="lp-sec lp-dark" aria-labelledby="prova-titulo" data-reveal>
    <div class="lp-wrap">
      <h2 class="lp-h2 lp-head" id="prova-titulo">{lp.prova.titulo}</h2>
      <ul class="lp-numeros">
        {lp.prova.numeros.map((n) => <li class="lp-numero"><strong>{n.numero}</strong><span>{n.rotulo}</span></li>)}
      </ul>
      {temResultados && (
        <ul class="lp-resultados">
          {lp.prova.resultados.map((r) => (
            <li class="lp-resultado"><strong>{r.numero}</strong><span>{r.rotulo}</span><em>{r.cliente}</em></li>
          ))}
        </ul>
      )}
      <ul class="lp-marcas" aria-label="Marcas atendidas">
        {lp.prova.marcas.map((m) => <li class="lp-marca">{m}</li>)}
      </ul>
    </div>
  </section>

  <!-- 5. CASES EM DESTAQUE -->
  <section class="lp-sec lp-light lp-mist" id="cases" aria-labelledby="cases-titulo" data-reveal>
    <div class="lp-wrap">
      <div class="lp-head">
        <span class="lp-eyebrow">{lp.cases.eyebrow}</span>
        <h2 class="lp-h2" id="cases-titulo">{lp.cases.titulo}</h2>
        <p class="lp-lead">{lp.cases.texto}</p>
      </div>
      <ul class="lp-cases-grid">
        {destaques.map((p) => {
          const capa = p.capa ?? p.imagens![0];
          return (
            <li>
              <a class="lp-case" href={`/portfolio#${slugProjeto(p)}`}>
                <span class="lp-case-img"><img src={capa.src} alt={capa.alt} loading="lazy"></span>
                <span class="lp-case-body">
                  <span class="lp-case-cat">{rotuloCategoria[p.cats[0]]}</span>
                  <span class="lp-case-title">{p.nome}</span>
                  <span class="lp-case-desc">{p.desc}</span>
                  <span class="lp-case-go" aria-hidden="true">Ver case →</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
      <div class="lp-more"><a class="btn btn-ghost btn-lg" href="/portfolio">{lp.cases.todos}</a></div>
    </div>
  </section>

  <!-- 6. MÉTODO -->
  <section class="lp-sec lp-dark" id="metodo" aria-labelledby="metodo-titulo" data-reveal>
    <div class="lp-wrap">
      <div class="lp-head">
        <span class="lp-eyebrow">{lp.metodo.eyebrow}</span>
        <h2 class="lp-h2" id="metodo-titulo">{lp.metodo.titulo}</h2>
        <p class="lp-lead">{lp.metodo.texto}</p>
      </div>
      <ol class="lp-etapas">
        {lp.metodo.etapas.map((e) => <li class="lp-etapa"><h3>{e.titulo}</h3><p>{e.texto}</p></li>)}
      </ol>
      <div class="lp-more" style="justify-content:flex-start">
        <a class="btn btn-primary btn-lg" href={contato.whatsappOrcamento} target="_blank" rel="noopener noreferrer">{lp.metodo.cta}</a>
      </div>
    </div>
  </section>

  <!-- 7. SERVIÇOS -->
  <section class="lp-sec lp-light" id="servicos" aria-labelledby="servicos-titulo" data-reveal>
    <div class="lp-wrap">
      <div class="lp-head">
        <span class="lp-eyebrow">{lp.servicos.eyebrow}</span>
        <h2 class="lp-h2" id="servicos-titulo">{lp.servicos.titulo}</h2>
      </div>
      <ul class="lp-servicos">
        {lp.servicos.itens.map((s) => (
          <li>
            <a class="lp-svc" href={s.href}>
              <h3>{s.titulo}</h3>
              <p class="ganho">{s.ganho}</p>
              <p class="desc">{s.texto}</p>
              <span class="go" aria-hidden="true">Ver exemplos →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. DEPOIMENTOS (só aparece com depoimentos preenchidos em src/data/lp.ts) -->
  {temDepoimentos && (
    <section class="lp-sec lp-light lp-mist" aria-labelledby="depo-titulo" data-reveal>
      <div class="lp-wrap">
        <h2 class="lp-h2 lp-head" id="depo-titulo">{lp.depoimentos.titulo}</h2>
        <ul class="lp-depo">
          {lp.depoimentos.itens.map((d) => (
            <li>
              <figure>
                <blockquote>“{d.texto}”</blockquote>
                <figcaption><strong>{d.nome}</strong>{d.negocio}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 9. SOBRE -->
  <section class="lp-sec lp-dark" id="sobre" aria-labelledby="sobre-titulo" data-reveal>
    <div class="lp-wrap lp-sobre-grid">
      <div>
        <div class="lp-sobre-mark"><img src="/images/logo.png" alt="" width="64" height="64" loading="lazy"></div>
        <span class="lp-eyebrow">{lp.sobre.eyebrow}</span>
        <h2 class="lp-h2" id="sobre-titulo">{lp.sobre.titulo}</h2>
      </div>
      <div>
        {lp.sobre.textos.map((t) => <p>{t}</p>)}
        <div class="lp-cta-row">
          <a class="btn btn-primary btn-lg" href={contato.whatsappOrcamento} target="_blank" rel="noopener noreferrer">{lp.sobre.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. DÚVIDAS -->
  <section class="lp-sec lp-light lp-mist" id="duvidas" aria-labelledby="faq-titulo" data-reveal>
    <div class="lp-wrap">
      <div class="lp-head lp-center">
        <span class="lp-eyebrow">{lp.faq.eyebrow}</span>
        <h2 class="lp-h2" id="faq-titulo">{lp.faq.titulo}</h2>
      </div>
      <div class="lp-faq">
        {lp.faq.itens.map((f) => (
          <details>
            <summary>{f.p}</summary>
            <div class="resp">
              <p style="margin:0">{f.r}</p>
              {f.link && <p style="margin:12px 0 0"><a href={f.link.href}>{f.link.rotulo} →</a></p>}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. FECHAMENTO -->
  <section class="lp-sec lp-dark lp-final" id="contato" aria-labelledby="contato-titulo" data-reveal>
    <span class="lp-eyebrow">{lp.final.eyebrow}</span>
    <h2 class="lp-h2" id="contato-titulo">{lp.final.titulo}</h2>
    <p>{lp.final.texto}</p>
    <a class="btn btn-primary btn-lg" href={contato.whatsappOrcamento} target="_blank" rel="noopener noreferrer">{lp.final.cta}</a>
    <p class="lp-email">Ou escreva para <a href={contato.emailHref}>{contato.email}</a></p>
  </section>
</main>

<Footer links={[{ href: '/portfolio', rotulo: 'Portfólio' }, { href: '/productdesign', rotulo: 'Vagas e trabalho em produto' }]} />
</Base>
